'use server';

import { cookies } from 'next/headers';
import { AUTH_CONFIG } from './constants';
import type { LoginRequest, RegisterRequest } from './types';

export async function loginAction(data: LoginRequest) {
  // TODO: Replace with your actual user lookup + bcrypt.compare
  const cookieStore = await cookies();

  // Placeholder tokens - replace with real JWT signing
  const accessToken = 'placeholder-access-token';
  const refreshToken = 'placeholder-refresh-token';

  cookieStore.set('access_token', accessToken, {
    ...AUTH_CONFIG.cookieOptions,
    maxAge: 15 * 60,
  });

  cookieStore.set('refresh_token', refreshToken, {
    ...AUTH_CONFIG.cookieOptions,
    maxAge: 7 * 24 * 60 * 60,
  });

  return { success: true };
}

export async function registerAction(data: RegisterRequest) {
  // TODO: Replace with your actual user creation
  return loginAction({ email: data.email, password: data.password });
}

export async function logoutAction() {
  const cookieStore = await cookies();
  cookieStore.delete('access_token');
  cookieStore.delete('refresh_token');
  return { success: true };
}
